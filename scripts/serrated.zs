import crafttweaker.block.IBlockStateMatcher;
import mods.serrated.CuttingSawOutputBuilder;
import mods.serrated.CuttingSawRecipeBuilder;

var oakLog as IBlockStateMatcher = <blockstate:minecraft:log:variant=oak,axis=x>
  | <blockstate:minecraft:log:variant=oak,axis=y>
  | <blockstate:minecraft:log:variant=oak,axis=z>;

CuttingSawRecipeBuilder.newRecipe(<minecraft:log:0>, oakLog, false)
  .addOutput(CuttingSawOutputBuilder.newOutput(<minecraft:planks:0> * 4, 20)
    .addExtra(<betterwithmods:bark:0>)
    .addExtra(<betterwithmods:material:22> * 2))
  .addOutput(<minecraft:stick> * 8, 30)
  .addToSaw("log_oak");

CuttingSawRecipeBuilder.newRecipe(<minecraft:planks:0>, <blockstate:minecraft:planks:variant=oak>, false)
  .addOutput(<minecraft:oak_stairs>, 20, <blockstate:minecraft:oak_stairs:facing=north,half=bottom,shape=straight>)
  .addOutput(<minecraft:wooden_slab> * 2, 20, <blockstate:minecraft:double_wooden_slab:variant=oak>)
  .addOutput(<minecraft:stick> * 2, 10)
  .addToSaw("planks_oak");

CuttingSawRecipeBuilder.newRecipe(<minecraft:sandstone:0>, <blockstate:minecraft:sandstone:type=sandstone>)
  .addOutput(<minecraft:sandstone:1>, 20, <blockstate:minecraft:sandstone:type=chiseled_sandstone>)
  .addOutput(<minecraft:sandstone:2>, 20, <blockstate:minecraft:sandstone:type=smooth_sandstone>)
  .addOutput(<minecraft:stone_slab:1> * 2, 20, <blockstate:minecraft:double_stone_slab:variant=sandstone>)
  .addOutput(<minecraft:sandstone_stairs>, 20, <blockstate:minecraft:sandstone_stairs:facing=north,half=bottom,shape=straight>)
  .addOutput(CuttingSawOutputBuilder.newOutput(<minecraft:diamond> * 2, 50)
    .addExtra(<minecraft:sand> * 3)
    .addExtra(<minecraft:iron_ingot>))
  .addToStonecutter("sandstone");

CuttingSawRecipeBuilder.newRecipe(<minecraft:diamond>)
  .addOutput(<quark:glass_shards> * 2)
  .addOutput(<betterwithmods:material:46> * 9, 4)
  .addToStonecutter("diamond");

