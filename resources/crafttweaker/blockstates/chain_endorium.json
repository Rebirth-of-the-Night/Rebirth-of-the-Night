{
    "multipart": [
        {
            "when": {
                "axis": "x"
            },
            "apply": {
                "model": "crafttweaker:chain_horizontal_endorium",
                "y": 90
            }
        },
        {
            "when": {
                "axis": "y"
            },
            "apply": {
                "model": "crafttweaker:chain_endorium"
            }
        },
        {
            "when": {
                "axis": "z"
            },
            "apply": {
                "model": "crafttweaker:chain_horizontal_endorium"
            }
        },
        {
            "when": {
                "axis": "x",
                "dangle": "true"
            },
            "apply": {
                "model": "crafttweaker:chain_dangle_endorium",
                "y": 90
            }
        },
        {
            "when": {
                "axis": "y|z",
                "dangle": "true"
            },
            "apply": {
                "model": "crafttweaker:chain_dangle_endorium"
            }
        }
    ]
}